{
  "name": "baseline-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Baseline court booking sandbox. A client of the /v1 data plane only.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "baseline-mcp": "dist/src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:e2e": "npm run build && node --test dist/test/e2e.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
